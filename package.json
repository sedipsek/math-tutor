{
  "name": "math-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=.env.local server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U math -d math_tutor",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local server/db/seed.ts",
    "db:ingest": "tsx --env-file=.env.local server/db/ingest.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@types/katex": "^0.16.8",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.8",
    "katex": "^0.17.0",
    "postgres": "^3.4.9",
    "pretendard": "^1.3.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^8.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vite": "^7.1.5"
  }
}
